# Configuración General del Proyecto
PROJECT_NAME="PhishCatch API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Base de Datos PostgreSQL
# Cadena de conexión directa estándar: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://phishcatch_user:phishcatch_password@localhost:5432/phishcatch_db"

POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="phishcatch_user"
POSTGRES_PASSWORD="phishcatch_password"
POSTGRES_DB="phishcatch_db"

# JWT y Seguridad
SECRET_KEY="CAMBIAR_ESTA_CLAVE_SECRETA_EN_PRODUCCION_GEN_CON_OPENSSL"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Configuración CORS (Separados por coma o lista JSON)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# APIs de Inteligencia de Amenazas (OSINT)
VIRUSTOTAL_API_KEY=""
